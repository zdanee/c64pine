--- a/vfetch.c	2026-10-11 20:47:28.026190915 +0200
+++ b/vfetch.c	2026-10-11 20:47:28.029851771 +0200
@@ -1149,6 +1149,12 @@
   while (*s)
   {
     unsigned char c = (unsigned char)*s;
+    if (c == 0x1b && s[1] == '[') {          /* c64: skip colour codes (multicolour logos) */
+      s += 2;
+      while (*s && !(*s >= 0x40 && *s <= 0x7e)) s++;
+      if (*s) s++;
+      continue;
+    }
     if ((c & 0xC0) != 0x80) width++;
     s++;
   }
@@ -1241,7 +1247,7 @@
   }
 
   if (!custom) distro_id = fetchos(1);
-  const Distro *distro = get_distro(distro_id);
+  const Distro *distro = get_distro(custom ? distro_id : "c64");   /* c64: the Commodore logo on every distro */
   if (watch == 1) stopwatch = start_timer();
   
   fill_logos_array();
