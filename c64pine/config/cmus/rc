# C64PINE: cmus in the terminal's (= the desktop's) colours: "default" is the screen/text colour, the bars are
# reverse video like C64 menus; numbers are the terminal's C64 palette (11 yellow, 12 white, 9 light red)
set color_win_bg=default
set color_win_fg=default
set color_win_attr=default
set color_win_dir=default
set color_win_title_bg=default
set color_win_title_fg=default
set color_win_title_attr=reverse
set color_win_sel_bg=default
set color_win_sel_fg=default
set color_win_sel_attr=reverse
set color_win_cur=12
set color_win_cur_sel_bg=default
set color_win_cur_sel_fg=12
set color_win_cur_sel_attr=reverse
set color_win_inactive_sel_bg=default
set color_win_inactive_sel_fg=default
set color_win_inactive_sel_attr=underline
set color_win_inactive_cur_sel_bg=default
set color_win_inactive_cur_sel_fg=12
set color_win_inactive_cur_sel_attr=underline
set color_titleline_bg=default
set color_titleline_fg=default
set color_titleline_attr=reverse
set color_statusline_bg=default
set color_statusline_fg=default
set color_statusline_attr=reverse
set color_separator=default
set color_cmdline_bg=default
set color_cmdline_fg=default
set color_info=11
set color_error=9
set color_trackwin_album_bg=default
set color_trackwin_album_fg=default
set color_trackwin_album_attr=reverse
set show_current_bitrate=true
set altformat_title=%f
set format_title=%a - %l - %t (%y)
