! c64-1x: Commodore 64 Openbox theme
! active window = cyan frame + title with blue text (light blue would melt into the border); inactive = grey

border.width: 2
padding.width: 2
padding.height: 2
window.client.padding.width: 2
window.client.padding.height: 2
window.handle.width: 0
menu.overlap.x: 0
menu.overlap.y: 0

window.active.border.color: @TITLE@
window.inactive.border.color: #7b7b7b
window.active.client.color: @TITLE@
window.inactive.client.color: #7b7b7b

window.active.title.bg: flat solid
window.active.title.bg.color: @TITLE@
window.active.title.separator.color: @TITLE@
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #7b7b7b
window.inactive.title.separator.color: #7b7b7b

window.active.label.bg: parentrelative
window.active.label.text.color: @SCREEN@
window.active.label.text.justify: left
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #4a4a4a
window.inactive.label.text.justify: left

window.active.handle.bg: flat solid
window.active.handle.bg.color: @TITLE@
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #7b7b7b
window.active.grip.bg: flat solid
window.active.grip.bg.color: @TITLE@
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #7b7b7b

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: @SCREEN@
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: @SCREEN@
window.active.button.hover.image.color: @TITLE@
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #ffffff
window.active.button.pressed.image.color: @SCREEN@
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: @SCREEN@
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: @SCREEN@
window.active.button.toggled.hover.image.color: @TITLE@
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #ffffff
window.active.button.toggled.pressed.image.color: @SCREEN@
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #7b7b7b

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #4a4a4a
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #4a4a4a
window.inactive.button.hover.image.color: #7b7b7b
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #ffffff
window.inactive.button.pressed.image.color: #4a4a4a
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #4a4a4a
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #4a4a4a
window.inactive.button.toggled.hover.image.color: #7b7b7b
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #ffffff
window.inactive.button.toggled.pressed.image.color: #4a4a4a
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #b2b2b2

menu.border.width: 2
menu.border.color: @TEXT@
menu.separator.color: @TEXT@
menu.separator.width: 2
menu.separator.padding.width: 0
menu.separator.padding.height: 2
menu.title.bg: flat solid
menu.title.bg.color: @TEXT@
menu.title.text.color: @SCREEN@
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: @SCREEN@
menu.items.text.color: @TEXT@
menu.items.disabled.text.color: #7b7b7b
menu.items.active.bg: flat solid
menu.items.active.bg.color: @TEXT@
menu.items.active.text.color: @SCREEN@
menu.items.active.disabled.text.color: #7b7b7b

osd.border.width: 2
osd.border.color: @TEXT@
osd.bg: flat solid
osd.bg.color: @SCREEN@
osd.label.bg: parentrelative
osd.label.text.color: @TEXT@
osd.hilight.bg: flat solid
osd.hilight.bg.color: @TEXT@
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #7b7b7b
