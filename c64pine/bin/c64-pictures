#!/bin/sh
: "${C64PINE:=$HOME/.c64pine}"
# c64-pictures [FILE|DIR]
# nsxiv with the rest of the folder loaded too, so next/prev works

[ -f "$C64PINE/config/scale.env" ] && . "$C64PINE/config/scale.env"
if [ -f "${1:-}" ]; then
	f=$(realpath "$1"); d=${f%/*}
	list=$(find "$d" -maxdepth 1 -type f | grep -iE '\.(jpe?g|png|gif|webp|bmp|tiff?|svg|xpm)$' | sort)
	n=$(echo "$list" | grep -nxF "$f" | cut -d: -f1)
	echo "$list" | exec nsxiv -a -i -n "${n:-1}" -N pictures
elif [ -d "${1:-}" ]; then
	exec nsxiv -a -t -r -N pictures "$1"
else
	find "$HOME" -maxdepth 4 -path "$HOME/.*" -prune -o -type f -print 2>/dev/null | grep -iE '\.(jpe?g|png|gif|webp|bmp)$' |
		sort | exec nsxiv -a -t -i -N pictures
fi
